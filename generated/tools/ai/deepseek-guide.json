{"html":"<html lang=\"zh-CN\"><head>\n    \n    \n    <title>DeepSeek API 使用指南 | 在线工具 - WebUtils</title>\n\n    <!-- SEO Meta Tags -->\n    \n    \n    \n    \n    \n\n    <!-- Open Graph -->\n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n\n    <!-- Twitter Card -->\n    \n    \n    \n    \n\n    <!-- Favicon & PWA -->\n    \n    \n    \n    \n    \n    \n\n    <!-- Structured Data -->\n    \n    \n\n    <!-- Global & Tool Styles -->\n    \n    \n    \n    \n    \n\n    \n  </head>\n  <body>\n    <div class=\"tool-main\" role=\"main\">\n      <div class=\"container\">\n        <header>\n          <h1>DeepSeek API 使用指南</h1>\n          <p class=\"subtitle\">最新 V3/R1 模型完整教程 · 价格计算 · 代码示例</p>\n        </header>\n\n        <div class=\"tabs\">\n          <button class=\"tab-btn active\" onclick=\"showTab('overview')\" aria-label=\"概览\">\n            概览\n          </button>\n          <button class=\"tab-btn\" onclick=\"showTab('quickstart')\" aria-label=\"快速开始\">\n            快速开始\n          </button>\n          <button class=\"tab-btn\" onclick=\"showTab('models')\" aria-label=\"模型对比\">\n            模型对比\n          </button>\n          <button class=\"tab-btn\" onclick=\"showTab('pricing')\" aria-label=\"价格计算\">\n            价格计算\n          </button>\n          <button class=\"tab-btn\" onclick=\"showTab('code')\" aria-label=\"代码示例\">代码示例</button>\n        </div>\n\n        <!-- 概览 -->\n        <div id=\"overview\" class=\"tab-content active\">\n          <div class=\"card\">\n            <h2>什么是 DeepSeek？</h2>\n            <p>\n              DeepSeek（深度求索）是中国领先的 AI 公司，其最新发布的\n              <strong>DeepSeek-V3</strong>\n              和\n              <strong>DeepSeek-R1</strong>\n              模型在多项基准测试中达到了 GPT-4 级别的性能，同时价格仅为其 1/10。\n            </p>\n\n            <div class=\"info-grid\" style=\"margin-top: 1.5rem\">\n              <div class=\"info-item\">\n                <label>API 基础地址</label>\n                <div class=\"value\">api.deepseek.com</div>\n              </div>\n              <div class=\"info-item\">\n                <label>兼容协议</label>\n                <div class=\"value\">OpenAI API 格式</div>\n              </div>\n              <div class=\"info-item\">\n                <label>最大上下文</label>\n                <div class=\"value\">128K tokens</div>\n              </div>\n              <div class=\"info-item\">\n                <label>输入价格 (V3)</label>\n                <div class=\"value\">¥1 / 百万 tokens</div>\n              </div>\n            </div>\n\n            <div class=\"links\">\n              <a href=\"https://platform.deepseek.com/\" target=\"_blank\" class=\"link-btn\">\n                🔑 获取 API Key\n              </a>\n              <a href=\"https://api-docs.deepseek.com/\" target=\"_blank\" class=\"link-btn secondary\">\n                📖 官方文档\n              </a>\n              <a href=\"https://chat.deepseek.com/\" target=\"_blank\" class=\"link-btn secondary\">\n                💬 在线体验\n              </a>\n            </div>\n          </div>\n\n          <div class=\"card\">\n            <h2>核心优势</h2>\n            <div class=\"info-grid\">\n              <div class=\"info-item\">\n                <label>极致性价比</label>\n                <div class=\"value\" style=\"font-size: 1rem\">\n                  价格仅为 GPT-4 的 1/10，Claude 的 1/5\n                </div>\n              </div>\n              <div class=\"info-item\">\n                <label>OpenAI 兼容</label>\n                <div class=\"value\" style=\"font-size: 1rem\">只需修改 base_url，现有代码即可迁移</div>\n              </div>\n              <div class=\"info-item\">\n                <label>中文优化</label>\n                <div class=\"value\" style=\"font-size: 1rem\">原生中文训练，中文场景表现更佳</div>\n              </div>\n              <div class=\"info-item\">\n                <label>推理能力</label>\n                <div class=\"value\" style=\"font-size: 1rem\">R1 模型支持深度思考，数学推理领先</div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <!-- 快速开始 -->\n        <div id=\"quickstart\" class=\"tab-content\">\n          <div class=\"card\">\n            <h2>快速开始</h2>\n\n            <div class=\"steps\">\n              <div class=\"step\">\n                <h4>注册账号并获取 API Key</h4>\n                <p>\n                  访问\n                  <a href=\"https://platform.deepseek.com/\" target=\"_blank\">platform.deepseek.com</a>\n                  ，注册账号后在 API Keys 页面创建密钥。新用户注册即送 500 万 tokens。\n                </p>\n              </div>\n\n              <div class=\"step\">\n                <h4>安装 OpenAI SDK</h4>\n                <p>DeepSeek API 与 OpenAI 格式完全兼容，可以直接使用 OpenAI 官方 SDK。</p>\n                <div class=\"code-header\">\n                  <span class=\"code-lang\">bash</span>\n                  <button class=\"copy-btn\" onclick=\"copyCode(this)\" aria-label=\"复制\">复制</button>\n                </div>\n                <pre><code># Python\npip install openai\n\n# Node.js\nnpm install openai</code></pre>\n              </div>\n\n              <div class=\"step\">\n                <h4>配置环境变量</h4>\n                <p>将 API Key 保存为环境变量，避免在代码中硬编码。</p>\n                <div class=\"code-header\">\n                  <span class=\"code-lang\">bash</span>\n                  <button class=\"copy-btn\" onclick=\"copyCode(this)\" aria-label=\"复制\">复制</button>\n                </div>\n                <pre><code># Linux/macOS\nexport DEEPSEEK_API_KEY=\"your-api-key\"\n\n# Windows PowerShell\n$env:DEEPSEEK_API_KEY=\"your-api-key\"</code></pre>\n              </div>\n\n              <div class=\"step\">\n                <h4>发送第一个请求</h4>\n                <p>使用以下代码测试 API 是否正常工作。</p>\n                <div class=\"code-header\">\n                  <span class=\"code-lang\">Python</span>\n                  <button class=\"copy-btn\" onclick=\"copyCode(this)\" aria-label=\"复制\">复制</button>\n                </div>\n                <pre><code><span class=\"keyword\">from</span> openai <span class=\"keyword\">import</span> OpenAI\n\nclient = OpenAI(\n    api_key=<span class=\"string\">\"your-api-key\"</span>,\n    base_url=<span class=\"string\">\"https://api.deepseek.com\"</span>\n)\n\nresponse = client.chat.completions.create(\n    model=<span class=\"string\">\"deepseek-chat\"</span>,  <span class=\"comment\"># V3 模型</span>\n    messages=[\n        {<span class=\"string\">\"role\"</span>: <span class=\"string\">\"user\"</span>, <span class=\"string\">\"content\"</span>: <span class=\"string\">\"你好，请介绍一下你自己\"</span>}\n    ]\n)\n\n<span class=\"function\">print</span>(response.choices[<span class=\"number\">0</span>].message.content)</code></pre>\n              </div>\n            </div>\n\n            <div class=\"tip\">\n              <div class=\"tip-title\">💡 提示</div>\n              <p>API Key 仅在创建时显示一次，请务必保存。如果丢失，需要删除重新创建。</p>\n            </div>\n          </div>\n        </div>\n\n        <!-- 模型对比 -->\n        <div id=\"models\" class=\"tab-content\">\n          <div class=\"card\">\n            <h2>模型列表</h2>\n            <div style=\"overflow-x: auto\">\n              <table class=\"model-table\">\n                <thead>\n                  <tr>\n                    <th>模型名称</th>\n                    <th>API 标识</th>\n                    <th>特点</th>\n                    <th>上下文</th>\n                    <th>输入价格</th>\n                    <th>输出价格</th>\n                  </tr>\n                </thead>\n                <tbody>\n                  <tr>\n                    <td>\n                      <strong>DeepSeek-V3</strong>\n                      <span class=\"badge badge-hot\">HOT</span>\n                    </td>\n                    <td><code>deepseek-chat</code></td>\n                    <td>通用对话，速度快</td>\n                    <td>128K</td>\n                    <td>¥1/M</td>\n                    <td>¥2/M</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <strong>DeepSeek-R1</strong>\n                      <span class=\"badge badge-reasoning\">推理</span>\n                    </td>\n                    <td><code>deepseek-reasoner</code></td>\n                    <td>深度思考，数学/代码强</td>\n                    <td>128K</td>\n                    <td>¥4/M</td>\n                    <td>¥16/M</td>\n                  </tr>\n                  <tr>\n                    <td><strong>DeepSeek-Coder</strong></td>\n                    <td><code>deepseek-coder</code></td>\n                    <td>代码生成与补全</td>\n                    <td>128K</td>\n                    <td>¥1/M</td>\n                    <td>¥2/M</td>\n                  </tr>\n                </tbody>\n              </table>\n            </div>\n\n            <div class=\"warning\">\n              <div class=\"tip-title\">⚠️ 注意</div>\n              <p>\n                <strong>缓存命中价格更低</strong>\n                ：当输入内容与之前请求相似时，缓存命中的 token 价格仅为 ¥0.1/百万（V3）或\n                ¥1/百万（R1）。\n              </p>\n            </div>\n          </div>\n\n          <div class=\"card\">\n            <h2>如何选择模型？</h2>\n            <div class=\"info-grid\">\n              <div class=\"info-item\">\n                <label>日常对话 / 文本处理</label>\n                <div class=\"value\">deepseek-chat (V3)</div>\n                <p style=\"color: var(--color-text-secondary); font-size: 0.85rem; margin-top: 0.5rem\">\n                  速度快、成本低，适合大多数场景\n                </p>\n              </div>\n              <div class=\"info-item\">\n                <label>数学 / 逻辑推理</label>\n                <div class=\"value\">deepseek-reasoner (R1)</div>\n                <p style=\"color: var(--color-text-secondary); font-size: 0.85rem; margin-top: 0.5rem\">\n                  支持 Chain-of-Thought，复杂问题首选\n                </p>\n              </div>\n              <div class=\"info-item\">\n                <label>代码生成 / 补全</label>\n                <div class=\"value\">deepseek-coder</div>\n                <p style=\"color: var(--color-text-secondary); font-size: 0.85rem; margin-top: 0.5rem\">\n                  专门优化，代码质量更高\n                </p>\n              </div>\n              <div class=\"info-item\">\n                <label>长文档处理</label>\n                <div class=\"value\">deepseek-chat (V3)</div>\n                <p style=\"color: var(--color-text-secondary); font-size: 0.85rem; margin-top: 0.5rem\">\n                  128K 上下文，支持长文本\n                </p>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <!-- 价格计算 -->\n        <div id=\"pricing\" class=\"tab-content\">\n          <div class=\"card\">\n            <h2>价格计算器</h2>\n            <div class=\"calculator\">\n              <div class=\"calc-row\">\n                <div class=\"calc-field\">\n                  <label>选择模型</label>\n                  <select id=\"calcModel\" onchange=\"calculatePrice()\">\n                    <option value=\"v3\">DeepSeek-V3 (deepseek-chat)</option>\n                    <option value=\"r1\">DeepSeek-R1 (deepseek-reasoner)</option>\n                    <option value=\"coder\">DeepSeek-Coder</option>\n                  </select>\n                </div>\n                <div class=\"calc-field\">\n                  <label>计费周期</label>\n                  <select id=\"calcPeriod\" onchange=\"calculatePrice()\">\n                    <option value=\"day\">每天</option>\n                    <option value=\"month\">每月</option>\n                  </select>\n                </div>\n              </div>\n              <div class=\"calc-row\">\n                <div class=\"calc-field\">\n                  <label for=\"input----tokens----\">输入 Tokens (万)</label>\n                  <input type=\"number\" id=\"inputTokens\" value=\"100\" min=\"0\" onchange=\"calculatePrice()\" aria-label=\"数字输入框\" placeholder=\"请输入数字输入框\">\n                </div>\n                <div class=\"calc-field\">\n                  <label for=\"input----tokens----\">输出 Tokens (万)</label>\n                  <input type=\"number\" id=\"outputTokens\" value=\"50\" min=\"0\" onchange=\"calculatePrice()\" aria-label=\"数字输入框\" placeholder=\"请输入数字输入框\">\n                </div>\n              </div>\n              <div class=\"calc-result\">\n                <div class=\"price\" id=\"totalPrice\">¥0.00</div>\n                <div class=\"detail\" id=\"priceDetail\">预估费用</div>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"card\">\n            <h2>价格对比</h2>\n            <div style=\"overflow-x: auto\">\n              <table class=\"model-table\">\n                <thead>\n                  <tr>\n                    <th>模型</th>\n                    <th>输入价格 (每百万)</th>\n                    <th>输出价格 (每百万)</th>\n                    <th>相比 GPT-4</th>\n                  </tr>\n                </thead>\n                <tbody>\n                  <tr>\n                    <td><strong>DeepSeek-V3</strong></td>\n                    <td>¥1 ($0.14)</td>\n                    <td>¥2 ($0.28)</td>\n                    <td style=\"color: var(--success-color)\">便宜 97%</td>\n                  </tr>\n                  <tr>\n                    <td><strong>DeepSeek-R1</strong></td>\n                    <td>¥4 ($0.55)</td>\n                    <td>¥16 ($2.19)</td>\n                    <td style=\"color: var(--success-color)\">便宜 85%</td>\n                  </tr>\n                  <tr>\n                    <td>GPT-4-Turbo</td>\n                    <td>$10</td>\n                    <td>$30</td>\n                    <td>-</td>\n                  </tr>\n                  <tr>\n                    <td>Claude 3.5 Sonnet</td>\n                    <td>$3</td>\n                    <td>$15</td>\n                    <td>便宜 70%</td>\n                  </tr>\n                </tbody>\n              </table>\n            </div>\n          </div>\n        </div>\n\n        <!-- 代码示例 -->\n        <div id=\"code\" class=\"tab-content\">\n          <div class=\"card\">\n            <h2>Python 示例</h2>\n\n            <h3>基础对话</h3>\n            <div class=\"code-header\">\n              <span class=\"code-lang\">Python</span>\n              <button class=\"copy-btn\" onclick=\"copyCode(this)\" aria-label=\"复制\">复制</button>\n            </div>\n            <pre><code><span class=\"keyword\">from</span> openai <span class=\"keyword\">import</span> OpenAI\n\nclient = OpenAI(\n    api_key=<span class=\"string\">\"your-api-key\"</span>,\n    base_url=<span class=\"string\">\"https://api.deepseek.com\"</span>\n)\n\n<span class=\"comment\"># 简单对话</span>\nresponse = client.chat.completions.create(\n    model=<span class=\"string\">\"deepseek-chat\"</span>,\n    messages=[\n        {<span class=\"string\">\"role\"</span>: <span class=\"string\">\"system\"</span>, <span class=\"string\">\"content\"</span>: <span class=\"string\">\"你是一个有帮助的助手\"</span>},\n        {<span class=\"string\">\"role\"</span>: <span class=\"string\">\"user\"</span>, <span class=\"string\">\"content\"</span>: <span class=\"string\">\"解释什么是机器学习\"</span>}\n    ],\n    temperature=<span class=\"number\">0.7</span>,\n    max_tokens=<span class=\"number\">2000</span>\n)\n\n<span class=\"function\">print</span>(response.choices[<span class=\"number\">0</span>].message.content)</code></pre>\n\n            <h3>流式输出</h3>\n            <div class=\"code-header\">\n              <span class=\"code-lang\">Python</span>\n              <button class=\"copy-btn\" onclick=\"copyCode(this)\" aria-label=\"复制\">复制</button>\n            </div>\n            <pre><code><span class=\"comment\"># 流式响应</span>\nstream = client.chat.completions.create(\n    model=<span class=\"string\">\"deepseek-chat\"</span>,\n    messages=[{<span class=\"string\">\"role\"</span>: <span class=\"string\">\"user\"</span>, <span class=\"string\">\"content\"</span>: <span class=\"string\">\"写一首关于春天的诗\"</span>}],\n    stream=<span class=\"keyword\">True</span>\n)\n\n<span class=\"keyword\">for</span> chunk <span class=\"keyword\">in</span> stream:\n    <span class=\"keyword\">if</span> chunk.choices[<span class=\"number\">0</span>].delta.content:\n        <span class=\"function\">print</span>(chunk.choices[<span class=\"number\">0</span>].delta.content, end=<span class=\"string\">\"\"</span>)</code></pre>\n\n            <h3>使用 R1 推理模型</h3>\n            <div class=\"code-header\">\n              <span class=\"code-lang\">Python</span>\n              <button class=\"copy-btn\" onclick=\"copyCode(this)\" aria-label=\"复制\">复制</button>\n            </div>\n            <pre><code><span class=\"comment\"># DeepSeek-R1 推理模型（带思考过程）</span>\nresponse = client.chat.completions.create(\n    model=<span class=\"string\">\"deepseek-reasoner\"</span>,\n    messages=[{\n        <span class=\"string\">\"role\"</span>: <span class=\"string\">\"user\"</span>, \n        <span class=\"string\">\"content\"</span>: <span class=\"string\">\"一个农夫带着狼、羊和白菜过河，每次只能带一样...\"</span>\n    }]\n)\n\n<span class=\"comment\"># R1 会返回思考过程</span>\n<span class=\"function\">print</span>(<span class=\"string\">\"思考过程:\"</span>, response.choices[<span class=\"number\">0</span>].message.reasoning_content)\n<span class=\"function\">print</span>(<span class=\"string\">\"最终答案:\"</span>, response.choices[<span class=\"number\">0</span>].message.content)</code></pre>\n          </div>\n\n          <div class=\"card\">\n            <h2>JavaScript/Node.js 示例</h2>\n            <div class=\"code-header\">\n              <span class=\"code-lang\">JavaScript</span>\n              <button class=\"copy-btn\" onclick=\"copyCode(this)\" aria-label=\"复制\">复制</button>\n            </div>\n            <pre><code><span class=\"keyword\">import</span> OpenAI <span class=\"keyword\">from</span> <span class=\"string\">'openai'</span>;\n\n<span class=\"keyword\">const</span> client = <span class=\"keyword\">new</span> <span class=\"function\">OpenAI</span>({\n    apiKey: <span class=\"string\">'your-api-key'</span>,\n    baseURL: <span class=\"string\">'https://api.deepseek.com'</span>\n});\n\n<span class=\"keyword\">async function</span> <span class=\"function\">chat</span>() {\n    <span class=\"keyword\">const</span> response = <span class=\"keyword\">await</span> client.chat.completions.<span class=\"function\">create</span>({\n        model: <span class=\"string\">'deepseek-chat'</span>,\n        messages: [\n            { role: <span class=\"string\">'user'</span>, content: <span class=\"string\">'Hello, DeepSeek!'</span> }\n        ]\n    });\n    \n    console.<span class=\"function\">log</span>(response.choices[<span class=\"number\">0</span>].message.content);\n}\n\n<span class=\"function\">chat</span>();</code></pre>\n          </div>\n\n          <div class=\"card\">\n            <h2>cURL 示例</h2>\n            <div class=\"code-header\">\n              <span class=\"code-lang\">bash</span>\n              <button class=\"copy-btn\" onclick=\"copyCode(this)\" aria-label=\"复制\">复制</button>\n            </div>\n            <pre><code>curl https://api.deepseek.com/chat/completions \\\n  -H \"Content-Type: application/json\" \\\n  -H \"Authorization: Bearer ${DEEPSEEK_API_KEY}\" \\\n  -d '{\n    \"model\": \"deepseek-chat\",\n    \"messages\": [\n      {\"role\": \"user\", \"content\": \"Hello!\"}\n    ]\n  }'</code></pre>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    \n\n    <!-- 全局 UI 注入 -->\n    \n  \n\n</body></html>","script":"// @ts-nocheck\n// Generated from tools/ai/deepseek-guide.html\n// Source SHA-256: ce40970e4b6b6144a9efe307d076cbf11c40bfcbf4b5e2fcdc7b4b957ead97ec\n// MIT: Copyright (c) 2025 chico; 2025-2026 chicogong\n// 主题切换\nwindow.toggleTheme = function () {\n    const html = document.documentElement;\n    const currentTheme = html.getAttribute(\"data-theme\");\n    const newTheme = currentTheme === \"light\" ? \"dark\" : \"light\";\n    html.setAttribute(\"data-theme\", newTheme);\n    localStorage.setItem(\"theme\", newTheme);\n};\n// 加载保存的主题\n(function () {\n    const savedTheme = localStorage.getItem(\"theme\") || \"dark\";\n    document.documentElement.setAttribute(\"data-theme\", savedTheme);\n})();\n// Tab 切换\nwindow.showTab = function (tabId) {\n    document.querySelectorAll(\".tab-content\").forEach((el) => el.classList.remove(\"active\"));\n    document.querySelectorAll(\".tab-btn\").forEach((el) => el.classList.remove(\"active\"));\n    document.getElementById(tabId).classList.add(\"active\");\n    event.target.classList.add(\"active\");\n};\n// 复制代码\nwindow.copyCode = function (btn) {\n    const pre = btn.closest(\".card\").querySelector(\"pre\");\n    const code = pre.textContent;\n    navigator.clipboard.writeText(code).then(() => {\n        const originalText = btn.textContent;\n        btn.textContent = \"已复制!\";\n        setTimeout(() => (btn.textContent = originalText), 2000);\n    });\n};\n// 价格计算\nconst pricing = {\n    v3: { input: 1, output: 2 }, // 每百万 tokens (RMB)\n    r1: { input: 4, output: 16 },\n    coder: { input: 1, output: 2 }\n};\nfunction calculatePrice() {\n    const model = document.getElementById(\"calcModel\").value;\n    const period = document.getElementById(\"calcPeriod\").value;\n    const inputTokens = parseFloat(document.getElementById(\"inputTokens\").value) || 0;\n    const outputTokens = parseFloat(document.getElementById(\"outputTokens\").value) || 0;\n    const prices = pricing[model];\n    // 转换为百万 tokens (输入是万)\n    const inputM = inputTokens / 100;\n    const outputM = outputTokens / 100;\n    let totalPerDay = inputM * prices.input + outputM * prices.output;\n    let total = period === \"month\" ? totalPerDay * 30 : totalPerDay;\n    document.getElementById(\"totalPrice\").textContent = \"¥\" + total.toFixed(2);\n    document.getElementById(\"priceDetail\").textContent =\n        `输入: ${inputTokens}万 × ¥${prices.input}/百万 + 输出: ${outputTokens}万 × ¥${prices.output}/百万` +\n            (period === \"month\" ? \" × 30天\" : \"\");\n}\n// 初始化计算\ncalculatePrice();\n","libraries":[],"network":false}