{"html":"<html lang=\"zh-CN\"><head>\n    \n    \n    <title>运动消耗卡路里计算器 - WebUtils</title>\n\n    <!-- SEO Meta Tags -->\n    \n    \n    \n    \n    \n\n    <!-- Open Graph -->\n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n\n    <!-- Twitter Card -->\n    \n    \n    \n    \n\n    <!-- Favicon & PWA -->\n    \n    \n    \n    \n    \n    \n\n    <!-- Structured Data -->\n    \n    \n\n    <!-- Global & Tool Styles -->\n    \n    \n    \n    \n\n    \n    \n  </head>\n  <body>\n    <h1 class=\"tool-page-heading\">运动消耗卡路里计算器</h1>\n    <div class=\"tool-main\" role=\"main\">\n      <main class=\"main-content\">\n        <div class=\"container\">\n          <!-- Page Header -->\n          <div class=\"page-header\">\n            <h2 class=\"page-title\">🔥 运动消耗卡路里计算器</h2>\n            <p class=\"page-subtitle\">计算不同运动消耗的卡路里</p>\n          </div>\n\n          <!-- Personal Information Card -->\n          <div class=\"card\">\n            <h3 class=\"card-title\">👤 个人信息</h3>\n            <div class=\"input-group\">\n              <label for=\"input-----kg-\">体重 (kg)</label>\n              <input type=\"number\" id=\"weight\" value=\"70\" min=\"30\" max=\"200\" step=\"1\" oninput=\"calculate()\" aria-label=\"数字输入框\" placeholder=\"请输入数字输入框\">\n            </div>\n            <div class=\"input-group\">\n              <label for=\"input----------\">运动时长 (分钟)</label>\n              <input type=\"number\" id=\"duration\" value=\"30\" min=\"1\" max=\"300\" step=\"1\" oninput=\"calculate()\" aria-label=\"数字输入框\" placeholder=\"请输入数字输入框\">\n            </div>\n          </div>\n\n          <!-- Exercise Selection Card -->\n          <div class=\"card\">\n            <h3 class=\"card-title\">🏃 选择运动类型</h3>\n\n            <div class=\"category-section\">\n              <div class=\"category-title\">🏃‍♂️ 有氧运动</div>\n              <div class=\"exercise-options\">\n                <button class=\"exercise-btn selected\" onclick=\"selectExercise(event, 'running', 9.8)\" data-exercise=\"running\">\n                  <span class=\"exercise-name\">跑步（8km/h）</span>\n                  <span class=\"exercise-met\">MET 9.8</span>\n                </button>\n                <button class=\"exercise-btn\" onclick=\"selectExercise(event, 'jogging', 7.0)\" data-exercise=\"jogging\">\n                  <span class=\"exercise-name\">慢跑（6km/h）</span>\n                  <span class=\"exercise-met\">MET 7.0</span>\n                </button>\n                <button class=\"exercise-btn\" onclick=\"selectExercise(event, 'walking', 4.0)\" data-exercise=\"walking\">\n                  <span class=\"exercise-name\">快走（5km/h）</span>\n                  <span class=\"exercise-met\">MET 4.0</span>\n                </button>\n                <button class=\"exercise-btn\" onclick=\"selectExercise(event, 'cycling', 8.0)\" data-exercise=\"cycling\">\n                  <span class=\"exercise-name\">骑车（中速）</span>\n                  <span class=\"exercise-met\">MET 8.0</span>\n                </button>\n                <button class=\"exercise-btn\" onclick=\"selectExercise(event, 'swimming', 8.3)\" data-exercise=\"swimming\">\n                  <span class=\"exercise-name\">游泳（自由泳）</span>\n                  <span class=\"exercise-met\">MET 8.3</span>\n                </button>\n              </div>\n            </div>\n\n            <div class=\"category-section\">\n              <div class=\"category-title\">💪 力量训练</div>\n              <div class=\"exercise-options\">\n                <button class=\"exercise-btn\" onclick=\"selectExercise(event, 'weightlifting', 6.0)\" data-exercise=\"weightlifting\">\n                  <span class=\"exercise-name\">举重训练</span>\n                  <span class=\"exercise-met\">MET 6.0</span>\n                </button>\n                <button class=\"exercise-btn\" onclick=\"selectExercise(event, 'bodyweight', 4.5)\" data-exercise=\"bodyweight\">\n                  <span class=\"exercise-name\">自重训练</span>\n                  <span class=\"exercise-met\">MET 4.5</span>\n                </button>\n                <button class=\"exercise-btn\" onclick=\"selectExercise(event, 'hiit', 10.0)\" data-exercise=\"hiit\">\n                  <span class=\"exercise-name\">HIIT 高强度</span>\n                  <span class=\"exercise-met\">MET 10.0</span>\n                </button>\n              </div>\n            </div>\n\n            <div class=\"category-section\">\n              <div class=\"category-title\">🧘 其他运动</div>\n              <div class=\"exercise-options\">\n                <button class=\"exercise-btn\" onclick=\"selectExercise(event, 'yoga', 3.0)\" data-exercise=\"yoga\">\n                  <span class=\"exercise-name\">瑜伽</span>\n                  <span class=\"exercise-met\">MET 3.0</span>\n                </button>\n                <button class=\"exercise-btn\" onclick=\"selectExercise(event, 'dancing', 5.0)\" data-exercise=\"dancing\">\n                  <span class=\"exercise-name\">跳舞</span>\n                  <span class=\"exercise-met\">MET 5.0</span>\n                </button>\n                <button class=\"exercise-btn\" onclick=\"selectExercise(event, 'basketball', 8.0)\" data-exercise=\"basketball\">\n                  <span class=\"exercise-name\">篮球</span>\n                  <span class=\"exercise-met\">MET 8.0</span>\n                </button>\n                <button class=\"exercise-btn\" onclick=\"selectExercise(event, 'soccer', 10.0)\" data-exercise=\"soccer\">\n                  <span class=\"exercise-name\">足球</span>\n                  <span class=\"exercise-met\">MET 10.0</span>\n                </button>\n              </div>\n            </div>\n          </div>\n\n          <!-- Result Card -->\n          <div class=\"result-card\">\n            <div class=\"result-label\">消耗卡路里</div>\n            <div class=\"result-value\" id=\"caloriesBurned\">206</div>\n            <div class=\"result-label\">千卡 (kcal)</div>\n\n            <div class=\"equivalents\">\n              <div class=\"equivalent-item\">\n                <div class=\"equivalent-icon\">🍚</div>\n                <div class=\"equivalent-value\" id=\"riceEquiv\">0.7</div>\n                <div class=\"equivalent-label\">碗米饭</div>\n              </div>\n              <div class=\"equivalent-item\">\n                <div class=\"equivalent-icon\">🍎</div>\n                <div class=\"equivalent-value\" id=\"appleEquiv\">3.9</div>\n                <div class=\"equivalent-label\">个苹果</div>\n              </div>\n              <div class=\"equivalent-item\">\n                <div class=\"equivalent-icon\">🍫</div>\n                <div class=\"equivalent-value\" id=\"chocolateEquiv\">0.4</div>\n                <div class=\"equivalent-label\">块巧克力</div>\n              </div>\n              <div class=\"equivalent-item\">\n                <div class=\"equivalent-icon\">🥤</div>\n                <div class=\"equivalent-value\" id=\"colaEquiv\">1.5</div>\n                <div class=\"equivalent-label\">听可乐</div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </main>\n    </div>\n\n    \n    \n\n    <!-- 全局 UI 注入 -->\n    \n  \n\n</body></html>","script":"// @ts-nocheck\n// Generated from tools/health/calorie-burn-calculator.html\n// Source SHA-256: a8617300db8be1eb79068f8d80d2ded26c732359b49163d9ad6006867aa8ffb4\n// MIT: Copyright (c) 2025 chico; 2025-2026 chicogong\nlet currentMET = 9.8;\nfunction selectExercise(event, type, met) {\n    currentMET = met;\n    // Update UI\n    document.querySelectorAll(\".exercise-btn\").forEach((btn) => {\n        btn.classList.remove(\"selected\");\n    });\n    event.target.closest(\".exercise-btn\").classList.add(\"selected\");\n    calculate();\n}\nfunction calculate() {\n    const weight = parseFloat(document.getElementById(\"weight\").value) || 70;\n    const duration = parseFloat(document.getElementById(\"duration\").value) || 30;\n    // MET formula: Calories = MET × weight (kg) × duration (hours)\n    const hours = duration / 60;\n    const calories = currentMET * weight * hours;\n    // Update display\n    document.getElementById(\"caloriesBurned\").textContent = Math.round(calories);\n    // Calculate food equivalents\n    const rice = calories / 300; // 1 bowl rice ≈ 300 kcal\n    const apple = calories / 52; // 1 apple ≈ 52 kcal\n    const chocolate = calories / 550; // 1 bar chocolate ≈ 550 kcal\n    const cola = calories / 140; // 1 can cola ≈ 140 kcal\n    document.getElementById(\"riceEquiv\").textContent = rice.toFixed(1);\n    document.getElementById(\"appleEquiv\").textContent = apple.toFixed(1);\n    document.getElementById(\"chocolateEquiv\").textContent = chocolate.toFixed(1);\n    document.getElementById(\"colaEquiv\").textContent = cola.toFixed(1);\n}\n// Initialize\ncalculate();\nfunction toggleTheme() {\n    const html = document.documentElement;\n    const currentTheme = html.getAttribute(\"data-theme\") || \"dark\";\n    const newTheme = currentTheme === \"light\" ? \"dark\" : \"light\";\n    html.setAttribute(\"data-theme\", newTheme);\n    localStorage.setItem(\"theme\", newTheme);\n}\nfunction initTheme() {\n    const savedTheme = localStorage.getItem(\"theme\");\n    const prefersDark = window.matchMedia(\"(prefers-color-scheme: dark)\").matches;\n    const theme = savedTheme || (prefersDark ? \"dark\" : \"light\");\n    document.documentElement.setAttribute(\"data-theme\", theme);\n}\n// ============================================\n// Initialize\n// ============================================\ninitTheme();\n","libraries":[],"network":false}