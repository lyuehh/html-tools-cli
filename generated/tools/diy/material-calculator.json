{"html":"<html lang=\"zh-CN\"><head>\n    \n    \n    <title>材料用量计算 - WebUtils</title>\n\n    <!-- SEO Meta Tags -->\n    \n    \n    \n    \n    \n\n    <!-- Open Graph -->\n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n\n    <!-- Twitter Card -->\n    \n    \n    \n    \n\n    <!-- Favicon & PWA -->\n    \n    \n    \n    \n    \n    \n\n    <!-- Structured Data -->\n    \n    \n\n    <!-- Global & Tool Styles -->\n    \n    \n    \n    \n\n    \n    \n  </head>\n  <body>\n    <div class=\"tool-main\" role=\"main\">\n      <div class=\"container\">\n        <h1>🔨 材料用量计算</h1>\n        <div class=\"card\">\n          <label for=\"input---------\">房间长度 (米)</label>\n          <input type=\"number\" id=\"length\" value=\"5\" aria-label=\"数字输入框\" placeholder=\"请输入数字输入框\">\n          <label for=\"input---------\">房间宽度 (米)</label>\n          <input type=\"number\" id=\"width\" value=\"4\" aria-label=\"数字输入框\" placeholder=\"请输入数字输入框\">\n          <button onclick=\"calc()\" aria-label=\"计算面积\">计算面积</button>\n          <div class=\"result\" id=\"result\"></div>\n        </div>\n      </div>\n    </div>\n\n    \n\n    <!-- 全局 UI 注入 -->\n    \n  \n\n</body></html>","script":"// @ts-nocheck\n// Generated from tools/diy/material-calculator.html\n// Source SHA-256: c44c6dc06a0401296089b89ba9aefdb21b5a382fa64fb2ad39562a6ddfc925f3\n// MIT: Copyright (c) 2025 chico; 2025-2026 chicogong\nfunction calc() {\n    const l = parseFloat(document.getElementById(\"length\").value) || 0;\n    const w = parseFloat(document.getElementById(\"width\").value) || 0;\n    const area = l * w;\n    document.getElementById(\"result\").textContent = `面积: ${area.toFixed(2)} 平方米`;\n}\n","libraries":[],"network":false}