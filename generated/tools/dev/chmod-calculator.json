{"html":"<html lang=\"zh-CN\"><head>\n    \n    \n    <title>Chmod 计算器 - WebUtils</title>\n\n    <!-- SEO Meta Tags -->\n    \n    \n    \n    \n    \n\n    <!-- Open Graph -->\n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n\n    <!-- Twitter Card -->\n    \n    \n    \n    \n\n    <!-- Favicon & PWA -->\n    \n    \n    \n    \n    \n    \n\n    <!-- Structured Data -->\n    \n    \n\n    <!-- Global & Tool Styles -->\n    \n    \n    \n    \n\n    \n    \n  </head>\n  <body>\n    <div class=\"tool-main\" role=\"main\">\n      <div class=\"container\">\n        <h1>🔐 Chmod权限计算器</h1>\n        <div class=\"card\">\n          <div class=\"result\">\n            <div class=\"result-numeric\" id=\"numeric\">755</div>\n            <div class=\"result-symbolic\" id=\"symbolic\">rwxr-xr-x</div>\n          </div>\n          <div class=\"permissions\">\n            <div class=\"perm-group\">\n              <div class=\"perm-title owner\">所有者 (Owner)</div>\n              <div class=\"perm-option\">\n                <input type=\"checkbox\" id=\"or\" checked=\"\" onchange=\"calc()\">\n                <label for=\"or\">读取 (r) = 4</label>\n              </div>\n              <div class=\"perm-option\">\n                <input type=\"checkbox\" id=\"ow\" checked=\"\" onchange=\"calc()\">\n                <label for=\"ow\">写入 (w) = 2</label>\n              </div>\n              <div class=\"perm-option\">\n                <input type=\"checkbox\" id=\"ox\" checked=\"\" onchange=\"calc()\">\n                <label for=\"ox\">执行 (x) = 1</label>\n              </div>\n            </div>\n            <div class=\"perm-group\">\n              <div class=\"perm-title group\">用户组 (Group)</div>\n              <div class=\"perm-option\">\n                <input type=\"checkbox\" id=\"gr\" checked=\"\" onchange=\"calc()\">\n                <label for=\"gr\">读取 (r) = 4</label>\n              </div>\n              <div class=\"perm-option\">\n                <input type=\"checkbox\" id=\"gw\" onchange=\"calc()\">\n                <label for=\"gw\">写入 (w) = 2</label>\n              </div>\n              <div class=\"perm-option\">\n                <input type=\"checkbox\" id=\"gx\" checked=\"\" onchange=\"calc()\">\n                <label for=\"gx\">执行 (x) = 1</label>\n              </div>\n            </div>\n            <div class=\"perm-group\">\n              <div class=\"perm-title other\">其他人 (Other)</div>\n              <div class=\"perm-option\">\n                <input type=\"checkbox\" id=\"tr\" checked=\"\" onchange=\"calc()\">\n                <label for=\"tr\">读取 (r) = 4</label>\n              </div>\n              <div class=\"perm-option\">\n                <input type=\"checkbox\" id=\"tw\" onchange=\"calc()\">\n                <label for=\"tw\">写入 (w) = 2</label>\n              </div>\n              <div class=\"perm-option\">\n                <input type=\"checkbox\" id=\"tx\" checked=\"\" onchange=\"calc()\">\n                <label for=\"tx\">执行 (x) = 1</label>\n              </div>\n            </div>\n          </div>\n          <div class=\"command\">\n            <div class=\"command-title\">Linux命令</div>\n            <div class=\"command-text\" id=\"command\">chmod 755 filename</div>\n            <div class=\"action-buttons\">\n              <button class=\"btn btn-primary\" onclick=\"copyCommand()\">📋 复制命令</button>\n              <button class=\"btn btn-secondary\" onclick=\"resetPerms()\">🔄 重置</button>\n            </div>\n          </div>\n          <div class=\"common-permissions\">\n            <div class=\"common-title\">常用权限</div>\n            <div class=\"common-grid\">\n              <div class=\"common-item\" onclick=\"setPerms(7, 7, 7)\">\n                <div class=\"common-value\">777</div>\n                <div class=\"common-desc\">完全开放</div>\n              </div>\n              <div class=\"common-item\" onclick=\"setPerms(7, 5, 5)\">\n                <div class=\"common-value\">755</div>\n                <div class=\"common-desc\">可执行文件</div>\n              </div>\n              <div class=\"common-item\" onclick=\"setPerms(7, 4, 4)\">\n                <div class=\"common-value\">744</div>\n                <div class=\"common-desc\">脚本文件</div>\n              </div>\n              <div class=\"common-item\" onclick=\"setPerms(6, 4, 4)\">\n                <div class=\"common-value\">644</div>\n                <div class=\"common-desc\">普通文件</div>\n              </div>\n              <div class=\"common-item\" onclick=\"setPerms(6, 0, 0)\">\n                <div class=\"common-value\">600</div>\n                <div class=\"common-desc\">私密文件</div>\n              </div>\n              <div class=\"common-item\" onclick=\"setPerms(7, 0, 0)\">\n                <div class=\"common-value\">700</div>\n                <div class=\"common-desc\">私密目录</div>\n              </div>\n              <div class=\"common-item\" onclick=\"setPerms(4, 0, 0)\">\n                <div class=\"common-value\">400</div>\n                <div class=\"common-desc\">只读私密</div>\n              </div>\n              <div class=\"common-item\" onclick=\"setPerms(0, 0, 0)\">\n                <div class=\"common-value\">000</div>\n                <div class=\"common-desc\">无权限</div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    \n\n    <!-- 全局 UI 注入 -->\n    \n  \n\n</body></html>","script":"// @ts-nocheck\n// Generated from tools/dev/chmod-calculator.html\n// Source SHA-256: d56d2438819cdf676017bb6e3fda37542a2e6216e80f5e5818bca4bc99ee0bf3\n// MIT: Copyright (c) 2025 chico; 2025-2026 chicogong\nfunction calc() {\n    const o = (document.getElementById(\"or\").checked ? 4 : 0) +\n        (document.getElementById(\"ow\").checked ? 2 : 0) +\n        (document.getElementById(\"ox\").checked ? 1 : 0);\n    const g = (document.getElementById(\"gr\").checked ? 4 : 0) +\n        (document.getElementById(\"gw\").checked ? 2 : 0) +\n        (document.getElementById(\"gx\").checked ? 1 : 0);\n    const t = (document.getElementById(\"tr\").checked ? 4 : 0) +\n        (document.getElementById(\"tw\").checked ? 2 : 0) +\n        (document.getElementById(\"tx\").checked ? 1 : 0);\n    const numeric = `${o}${g}${t}`;\n    const toSymbolic = (n) => (n & 4 ? \"r\" : \"-\") + (n & 2 ? \"w\" : \"-\") + (n & 1 ? \"x\" : \"-\");\n    const symbolic = toSymbolic(o) + toSymbolic(g) + toSymbolic(t);\n    document.getElementById(\"numeric\").textContent = numeric;\n    document.getElementById(\"symbolic\").textContent = symbolic;\n    document.getElementById(\"command\").textContent = `chmod ${numeric} filename`;\n}\nfunction setPerms(o, g, t) {\n    document.getElementById(\"or\").checked = o & 4;\n    document.getElementById(\"ow\").checked = o & 2;\n    document.getElementById(\"ox\").checked = o & 1;\n    document.getElementById(\"gr\").checked = g & 4;\n    document.getElementById(\"gw\").checked = g & 2;\n    document.getElementById(\"gx\").checked = g & 1;\n    document.getElementById(\"tr\").checked = t & 4;\n    document.getElementById(\"tw\").checked = t & 2;\n    document.getElementById(\"tx\").checked = t & 1;\n    calc();\n}\nfunction copyCommand() {\n    const command = document.getElementById(\"command\").textContent;\n    navigator.clipboard.writeText(command).then(() => {\n        const btn = event.target;\n        const originalText = btn.textContent;\n        btn.textContent = \"✅ 已复制！\";\n        setTimeout(() => {\n            btn.textContent = originalText;\n        }, 2000);\n    });\n}\nfunction resetPerms() {\n    setPerms(7, 5, 5); // 默认 755\n}\ncalc();\n","libraries":[],"network":false}