{
  "name": "html-tools-cli",
  "version": "0.1.0",
  "description": "TypeScript CLI ports of the local, non-interactive WebUtils tools",
  "type": "module",
  "license": "MIT",
  "bin": {
    "html-tools": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "dist",
    "generated",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "generate": "node --experimental-strip-types scripts/generate.ts",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "start": "node dist/cli.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "docs": "node --experimental-strip-types scripts/docs.ts",
    "verify:catalog": "node --test tests/catalog.test.mjs",
    "prepack": "npm run build",
    "upstream": "node scripts/upstream.mjs"
  },
  "dependencies": {
    "@keeex/qrcodejs-kx": "^1.0.2",
    "@napi-rs/canvas": "^1.0.13",
    "acorn": "^8.19.0",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.6.1",
    "crypto-js": "^4.2.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "js-beautify": "^2.0.3",
    "js-yaml": "^5.5.0",
    "jsbarcode": "^3.11.5",
    "jsdom": "^26.1.0",
    "jszip": "^3.10.1",
    "katex": "^0.19.1",
    "marked": "^18.1.2",
    "mathjs": "^15.2.0",
    "openpgp": "^6.3.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174",
    "pinyin-pro": "^3.29.5",
    "qrcode-generator": "^1.4.4",
    "source-map": "^0.8.0",
    "sql.js": "^1.15.2",
    "terser": "^5.51.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
